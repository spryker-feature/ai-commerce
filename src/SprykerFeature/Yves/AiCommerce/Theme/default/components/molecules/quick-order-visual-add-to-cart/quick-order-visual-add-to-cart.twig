{% extends model('component') %}

{% define config = {
    name: 'quick-order-visual-add-to-cart',
    tag:  'quick-order-visual-add-to-cart',
} %}

{% define data = {
    form: required,
    supportedFileExtensions: [],
} %}

{% define attributes = {
    'input-file-id': data.form.children.orderFile.vars.id,
    'max-file-size': data.form.vars.maxFileSizeInBytes | default(0),
    'file-size-error-message': 'ai-commerce.quick-order-visual-add-to-cart.order-file.errors.file-too-large' | trans,
} %}

{% block body %}
    <div class="{{ config.name }}__content">
        {% block title %}
            <h5 class="{{ config.name }}__title spacing-bottom">{{ 'ai-commerce.quick-order-visual-add-to-cart.file-upload.title' | trans }}</h5>
        {% endblock %}

        {% block text %}
            {% set supportedExtensions = data.supportedFileExtensions is not empty
                ? data.supportedFileExtensions
                : data.form.vars.supportedFileExtensions | default([]) %}

            {% if supportedExtensions is not empty %}
                {% set fileExtensions = supportedExtensions | join(', ') | upper %}
                <p {{ qa('quick-order-visual-add-to-cart-description') }}>{{ 'ai-commerce.quick-order-visual-add-to-cart.file-upload.description' | trans({'%formats%': fileExtensions}) }}</p>
            {% endif %}
        {% endblock %}

        {% block orderFileForm %}
            {% embed molecule('form') with {
                modifiers: ['browse-file'],
                data: {
                    form: data.form,
                    enableStart: false,
                    enableEnd: false,
                },
                embed: {
                    parentClass: config.name,
                    parentJsClass: config.jsName,
                },
            } only %}

                {% block fields %}
                    {{ parent() }}
                    <label class="label label--browse-file spacing-bottom spacing-bottom--reset {{ embed.parentJsClass }}__browse-file"
                           for="{{ data.form.children.orderFile.vars.id }}">
                        <span class="{{ embed.parentClass }}__browse-file-info">
                            {% include atom('icon') with {
                                class: 'spacing-bottom',
                                modifiers: ['browse-file'],
                                data: {
                                    name: 'browse-file',
                                },
                            } only %}

                            <span class="{{ embed.parentClass }}__file-select text-center">
                                <span class="{{ embed.parentJsClass }}__file-select">
                                    {{ 'ai-commerce.quick-order-visual-add-to-cart.file-upload.browse-file' | trans }}
                                </span>

                                {% include atom('icon') with {
                                    class: 'is-hidden ' ~ embed.parentJsClass ~ '__remove-file',
                                    modifiers: ['small', 'remove-file'],
                                    data: {
                                        name: 'remove',
                                    },
                                } only %}
                            </span>
                        </span>
                    </label>
                {% endblock %}
            {% endembed %}
        {% endblock %}

        {% block button %}
            <button type="submit" name="uploadOrderFile" class="button button--success spacing-top spacing-top--big" {{ qa('quick-order-visual-add-to-cart-upload-button') }}>
                {{ 'ai-commerce.quick-order-visual-add-to-cart.file-upload.button.upload' | trans }}
            </button>
        {% endblock %}
    </div>
{% endblock %}
