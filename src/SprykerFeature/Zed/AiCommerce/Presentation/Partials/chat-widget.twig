{% if isBackofficeAssistantEnabled() %}
    <link rel="stylesheet" href="{{ assetsPath('css/spryker-zed-ai-commerce.css') }}" />

    {% set attachmentConfig = getSmartCmsAttachmentConfig() %}

    {% embed '@AiCommerce/Chat/core/chat.twig' with {
        chat: {
            promptUrl: url('/ai-commerce/backoffice-assistant-chat/prompt'),
            conversationsUrl: url('/ai-commerce/backoffice-assistant-chat/conversations'),
            conversationMessagesUrl: url('/ai-commerce/backoffice-assistant-chat/conversation-messages'),
            deleteConversationUrl: url('/ai-commerce/backoffice-assistant-chat/delete-conversation'),
            csrfToken: csrf_token('backoffice-assistant'),
            userName: username is defined ? username : '',
            maxMessageLength: 0,
        },
        features: {
            agentSelector: {
                loadAgents: true,
            },
            docking: {
                target: 'none',
            },
            attachments: {
                accept: attachmentConfig.allowedMediaTypes | join(','),
                maxSizeBytes: attachmentConfig.maxFileSizeBytes,
                maxCount: attachmentConfig.maxCount,
            },
        },
    } %}
        {% block toolCall %}
            <template data-block="toolCall">
                <div class="chat-tool-calls__card">
                    <span class="chat-tool-calls__label">
                        <svg class="spryker-chat__icon chat-tool-calls__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></g></svg>
                        <span class="chat-tool-calls__name" data-ref="name">
                            {{- 'ai_commerce.storefront_assistant.activity.tool_result' | trans -}}
                        </span>
                    </span>
                    <button type="button" class="chat-tool-calls__toggle" data-ref="toggle">
                        <span data-ref="showLabel">{{ 'ai_commerce.storefront_assistant.action.show_result' | trans }}</span>
                        <span data-ref="hideLabel">{{ 'ai_commerce.storefront_assistant.action.hide_result' | trans }}</span>
                    </button>
                    <pre class="chat-tool-calls__result" data-ref="result"></pre>
                </div>
            </template>
        {% endblock %}
        {% block hostFeatures %}
            {% include '@AiCommerce/Partials/Chat/form-fill.twig' only %}
            {% include '@AiCommerce/Partials/Chat/form-context.twig' only %}
            {% include '@AiCommerce/Partials/Chat/page-context.twig' only %}
        {% endblock %}
    {% endembed %}

    {% include '@AiCommerce/Partials/Chat/trigger.twig' only %}


    <script src="{{ assetsPath('js/spryker-zed-ai-commerce.js') }}"></script>
{% endif %}
