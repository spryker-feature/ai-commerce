{% if isSmartCmsEnabled() %}
    {% set smartCmsAttachmentConfig = getSmartCmsAttachmentConfig() %}

    <link rel="stylesheet" href="{{ assetsPath('css/spryker-zed-smart-cms-content.css') }}" />

    <div class="smart-cms-panel js-smart-cms-panel"
         role="form"
         aria-label="{{ 'Smart CMS Content Assistant' | trans }}"
         data-collapsed-class="smart-cms-panel--collapsed"
         data-busy-class="smart-cms-panel__ask--busy"
         data-message-visible-class="smart-cms-panel__message--visible"
         data-message-success-class="smart-cms-panel__message--success"
         data-message-error-class="smart-cms-panel__message--error"
         data-i18n-done="{{ 'AI updated the content.' | trans | e('html_attr') }}"
         data-i18n-generating="{{ 'Generating…' | trans | e('html_attr') }}"
         data-i18n-connection-error="{{ 'The AI request could not be completed. Please try again.' | trans | e('html_attr') }}"
         data-i18n-attachment-too-large="{{ 'A file exceeds the allowed size and was not attached.' | trans | e('html_attr') }}"
         data-i18n-attachment-unsupported="{{ 'A file type is not allowed and was not attached.' | trans | e('html_attr') }}"
         data-i18n-attachment-count-exceeded="{{ 'Too many files attached.' | trans | e('html_attr') }}"
         data-i18n-attachment-total-size-exceeded="{{ 'The attachments are too large in total.' | trans | e('html_attr') }}"
         data-i18n-attachment-read-error="{{ 'A file could not be read and was not attached.' | trans | e('html_attr') }}">
        <button type="button"
                class="smart-cms-panel__header js-smart-cms-panel__toggle"
                aria-expanded="false"
                aria-label="{{ 'Toggle Smart CMS panel' | trans }}"
                title="{{ 'Toggle Smart CMS panel' | trans }}">
            <span class="smart-cms-panel__heading">
                <svg class="smart-cms-panel__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 90 90" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M26.5664 41.5666L32.0673 25.0642H39.1824L44.6832 41.5666L61.1857 47.0675V54.1826L44.6832 59.6834L39.1824 76.1859H32.0673L26.5664 59.6834L10.064 54.1826V47.0675L26.5664 41.5666ZM35.6248 38.1086L33.0886 45.7171L30.7169 48.0888L23.1084 50.625L30.7169 53.1612L33.0886 55.5329L35.6248 63.1415L38.161 55.5329L40.5327 53.1612L48.1413 50.625L40.5327 48.0888L38.161 45.7171L35.6248 38.1086Z" fill="currentColor"/>
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M60.5648 19.315L63.4903 10.5385H67.7594L70.6849 19.315L79.4613 22.2405V26.5096L70.6849 29.4351L67.7594 38.2115H63.4903L60.5648 29.4351L51.7883 26.5096V22.2405L60.5648 19.315Z" fill="currentColor"/>
                </svg>
                <span class="smart-cms-panel__title">{{ 'Smart CMS Content Assistant' | trans }}</span>
            </span>
            <span class="smart-cms-panel__chevron fa fa-chevron-down" aria-hidden="true"></span>
        </button>
        <div class="smart-cms-panel__body">
            <textarea class="smart-cms-panel__input js-smart-cms-panel__input"
                      rows="3"
                      placeholder="{{ 'Ask AI to generate or edit the title and content…' | trans }}"
                      aria-label="{{ 'AI request' | trans }}"></textarea>
            <div class="smart-cms-panel__actions">
                <button type="button" class="smart-cms-panel__ask js-smart-cms-panel__ask" data-label-idle="{{ 'Ask AI' | trans | e('html_attr') }}">
                    <span class="smart-cms-panel__spinner" aria-hidden="true"></span>
                    <span class="js-smart-cms-panel__ask-label">{{ 'Ask AI' | trans }}</span>
                </button>
                <button type="button"
                        class="smart-cms-panel__attach js-smart-cms-panel__attach"
                        aria-label="{{ 'Attach files' | trans }}"
                        title="{{ 'Attach files' | trans }}">
                    <span class="fa fa-paperclip" aria-hidden="true"></span>
                </button>
                <input type="file"
                       class="smart-cms-panel__file-input js-smart-cms-panel__file-input"
                       multiple
                       accept="{{ smartCmsAttachmentConfig.allowedMediaTypes | join(',') }}"
                       hidden>
            </div>
            <ul class="smart-cms-panel__attachments js-smart-cms-panel__attachments"></ul>
        </div>
        <div class="smart-cms-panel__message js-smart-cms-panel__message" role="status" aria-live="polite"></div>
        <template class="js-smart-cms-attachment-template">
            <li class="smart-cms-panel__attachment">
                <span class="smart-cms-panel__attachment-name js-smart-cms-panel__attachment-name"></span>
                <button type="button"
                        class="smart-cms-panel__attachment-remove js-smart-cms-panel__attachment-remove"
                        aria-label="{{ 'Remove attachment' | trans }}"
                        title="{{ 'Remove attachment' | trans }}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </li>
        </template>
    </div>

    <script>
        window.SmartCmsContentConfig = {
            endpoint: '{{ url('/ai-commerce/smart-cms-content/generate') | e('js') }}',
            csrfToken: '{{ csrf_token('smart-cms-content') | e('js') }}',
            entityType: '{{ smartCmsEntityType | default('') | e('js') }}',
            idEntity: {{ smartCmsIdEntity | default(0) }},
            entityContext: {{ smartCmsEntityContext | default({}) | json_encode | raw }},
            attachments: {{ smartCmsAttachmentConfig | json_encode | raw }}
        };
    </script>
    <script src="{{ assetsPath('js/spryker-zed-smart-cms-content.js') }}"></script>
{% endif %}
