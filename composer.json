{
    "name": "spryker-feature/ai-commerce",
    "type": "library",
    "description": "AiCommerce module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker-shop/quick-order-page-extension": "^1.3.0",
        "spryker-shop/shop-ui": "^1.104.0 || ^2.0.0",
        "spryker/ai-foundation": "^0.9.0",
        "spryker/application": "^3.46.0",
        "spryker/availability-storage": "^2.2.0",
        "spryker/catalog": "^5.12.0",
        "spryker/category": "^5.24.0",
        "spryker/category-storage": "^1.11.0 || ^2.0.0",
        "spryker/cms-storage": "^2.4.0",
        "spryker/configuration": "^1.0.0",
        "spryker/content": "^2.0.0",
        "spryker/content-gui": "^3.0.0",
        "spryker/content-gui-extension": "^1.0.0",
        "spryker/currency": "^4.0.0",
        "spryker/customer": "^7.0.0",
        "spryker/discount": "^9.0.0",
        "spryker/glossary": "^3.0.0",
        "spryker/glossary-storage": "^1.0.0",
        "spryker/kernel": "^3.72.0",
        "spryker/locale": "^4.12.0",
        "spryker/log": "^3.0.0",
        "spryker/merchant-storage": "^1.0.0",
        "spryker/messenger": "^3.6.0",
        "spryker/money": "^2.0.0",
        "spryker/oms": "^11.0.0",
        "spryker/permission": "^1.0.0",
        "spryker/price": "^5.0.0",
        "spryker/price-product-storage": "^4.0.0",
        "spryker/product-alternative-storage": "^1.0.0",
        "spryker/product-bundle-storage": "^1.0.0",
        "spryker/product-category-storage": "^1.11.0 || ^2.6.0",
        "spryker/product-discontinued-storage": "^1.0.0",
        "spryker/product-image-storage": "^1.19.0",
        "spryker/product-label-storage": "^2.0.0",
        "spryker/product-management-extension": "^1.11.0",
        "spryker/product-offer-storage": "^1.0.0",
        "spryker/product-option-storage": "^1.6.0",
        "spryker/product-relation-storage": "^1.6.0 || ^2.0.0",
        "spryker/product-review-storage": "^1.0.0",
        "spryker/product-set-page-search": "^1.0.0",
        "spryker/product-set-storage": "^1.0.0",
        "spryker/product-storage": "^1.53.0",
        "spryker/propel-orm": "^1.20.0",
        "spryker/sales": "^11.0.0",
        "spryker/search-extension": "^1.0.0",
        "spryker/session": "^4.0.0",
        "spryker/storage": "^3.0.0",
        "spryker/store": "^1.19.0",
        "spryker/symfony": "^3.19.0",
        "spryker/transfer": "^3.42.0",
        "spryker/twig-extension": "^1.0.0",
        "spryker/user": "^3.0.0",
        "spryker/util-encoding": "^2.1.1"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/container": "*",
        "spryker/content-banner-gui": "*",
        "spryker/country": "*",
        "spryker/product": "*",
        "spryker/product-label": "*",
        "spryker/product-search-config-storage": "*",
        "spryker/propel": "*",
        "spryker/router": "*",
        "spryker/shipment": "*",
        "spryker/storage-redis": "*",
        "spryker/store-storage": "*",
        "spryker/testify": "*",
        "spryker/twig": "*"
    },
    "suggest": {
        "spryker/container": "When using BackofficeAssistant",
        "spryker/product": "When using AI-based product management features",
        "spryker/product-category": "When using category suggestions in product management.",
        "spryker/router": "When using StorefrontAssistantRouteProviderPlugin or SearchByImageRouteProviderPlugin",
        "spryker/twig": "When using AiCommerceTwigPlugin"
    },
    "autoload": {
        "psr-4": {
            "SprykerFeature\\": "src/SprykerFeature/",
            "SprykerFeatureTest\\Zed\\AiCommerce\\Helper\\": "tests/SprykerFeatureTest/Zed/AiCommerce/_support/Helper/",
            "SprykerFeatureTest\\Client\\AiCommerce\\Helper\\": "tests/SprykerFeatureTest/Client/AiCommerce/_support/Helper/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerFeatureTest\\": "tests/SprykerFeatureTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
